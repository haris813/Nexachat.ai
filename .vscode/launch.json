{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NexaChat: Flask (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "FLASK_APP": "wsgi:app",
        "FLASK_DEBUG": "1"
      },
      "args": ["run", "--host", "0.0.0.0", "--port", "5000"],
      "jinja": true,
      "justMyCode": true
    }
  ]
}
