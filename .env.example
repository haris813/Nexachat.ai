# Core application
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
PORT=5000
SECRET_KEY=replace-with-at-least-32-random-characters
# Fernet key recommended: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=false
AUTH_REQUIRED=false
DEMO_MODE=true
LOG_LEVEL=INFO
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# NexaChat uses OpenRouter for AI. Demo mode is opt-in and disabled by default.
AI_PROVIDER=openrouter
AI_DEMO_MODE=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
MAX_OUTPUT_TOKENS=1400
MAX_HISTORY_MESSAGES=30
MAX_INPUT_CHARS=12000
MAX_SYSTEM_PROMPT_CHARS=4000
MAX_CONVERSATIONS_PER_SESSION=100

# Web research: tavily | serper | brave | demo
# Current-data requests fail safely when SEARCH_PROVIDER=demo.
SEARCH_PROVIDER=demo
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARCH_MAX_RESULTS=8
WEB_REQUEST_TIMEOUT=15
ALLOW_PRIVATE_URLS=false

# Secure file storage and retention
UPLOAD_DIR=
ARTIFACT_DIR=
MAX_UPLOAD_MB=25
MAX_EXTRACTED_CHARS=120000
FILE_RETENTION_HOURS=168
FILE_BACKGROUND_THRESHOLD_MB=8

# Storage backend: local (default) | s3
# S3 mode works with AWS S3, Cloudflare R2, and Railway Buckets.
# Local mode stores files on the app server filesystem.
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_PRESIGN_EXPIRY=3600

# Meta WhatsApp Cloud API. Keep WHATSAPP_MODE=mock for a no-send demo.
WHATSAPP_MODE=mock
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# Leave blank for local SQLite. Docker Compose supplies PostgreSQL.
DATABASE_URL=

# Redis backs distributed rate limits and large-file background jobs.
REDIS_URL=
RATE_LIMIT=120 per hour
